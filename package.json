{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:claims": "node scripts/check-claims.js",
    "test:interaction-budget": "node scripts/interaction-budget-runner.cjs",
    "test:interaction-budget:desktop": "node scripts/assert-interaction-budget.cjs",
    "test:interaction-budget:mobile": "node scripts/assert-interaction-budget-mobile.cjs",
    "conformance:scaffold:dry": "node scripts/conformance/scaffold-policies.cjs",
    "conformance:scaffold": "node scripts/conformance/scaffold-policies.cjs --write",
    "conformance:check": "node scripts/conformance/validate-policies.cjs",
    "conformance:report": "node scripts/conformance/generate-dashboard.cjs",
    "conformance:ci": "npm run conformance:check && npm run conformance:report",
    "audit:headings": "node scripts/audit-headings.cjs",
    "audit:readability": "node scripts/audit-readability.cjs",
    "audit:images": "node scripts/audit-images.cjs",
    "audit:static": "node scripts/audit-headings.cjs && node scripts/audit-readability.cjs && node scripts/audit-images.cjs",
    "audit:routes": "node scripts/audit/discover-routes.mjs",
    "audit:visual": "node scripts/audit/run-visual-audit.mjs",
    "audit:a11y": "node scripts/audit/run-accessibility-audit.mjs",
    "audit:content": "node scripts/audit/run-content-audit.mjs",
    "audit:conversion": "node scripts/audit/run-conversion-audit.mjs",
    "audit:report": "node scripts/audit/generate-full-site-audit.mjs",
    "audit:wait": "node scripts/audit/wait-for-server.mjs http://127.0.0.1:5173 30000",
    "audit:icp": "node scripts/audit/run-icp-evidence-audit.mjs",
    "audit:pipeline": "node scripts/audit/discover-routes.mjs && node scripts/audit/run-visual-audit.mjs && node scripts/audit/run-accessibility-audit.mjs && node scripts/audit/run-content-audit.mjs && node scripts/audit/run-conversion-audit.mjs && node scripts/audit/run-icp-evidence-audit.mjs && node scripts/audit/generate-full-site-audit.mjs",
    "audit:all": "start-server-and-test dev:audit http://127.0.0.1:5173 audit:pipeline",
    "audit:all:local": "start-server-and-test dev:audit http://127.0.0.1:5173 \"npm run audit:pipeline -- --local\"",
    "audit:all:live": "node scripts/audit/discover-routes.mjs --live && node scripts/audit/run-visual-audit.mjs --live && node scripts/audit/run-accessibility-audit.mjs --live && node scripts/audit/run-content-audit.mjs --live && node scripts/audit/run-conversion-audit.mjs --live && node scripts/audit/generate-full-site-audit.mjs --live",
    "dev:audit": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "launch:check": "npm run typecheck && npm run build && npm run audit:all && node scripts/audit/check-launch-ready.mjs",
    "launch:readiness": "node scripts/audit/check-launch-readiness.mjs",
    "launch:gate": "npm run typecheck && npm run build && npm run audit:all && node scripts/audit/check-launch-readiness.mjs",
    "export:gpt-review": "node scripts/export-for-gpt-review.cjs",
    "prerender": "node scripts/prerender.cjs",
    "build:static": "vite build && node scripts/prerender.cjs",
    "export:ai-audit": "node scripts/export-ai-audit.cjs",
    "test:responsive": "npx playwright test tests/e2e/home-responsive.spec.ts",
    "test:responsive:ui": "npx playwright test tests/e2e/home-responsive.spec.ts --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.57.4",
    "@types/qrcode": "^1.5.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.344.0",
    "pdfjs-dist": "^4.9.155",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.11.0",
    "tesseract.js": "^5.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "cheerio": "^1.2.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "fast-glob": "^3.3.2",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
